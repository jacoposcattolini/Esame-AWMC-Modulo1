PORT=3000
DATABASE_URL=postgresql://sporteasy:sporteasy@localhost:5432/sporteasy
JWT_SECRET=cambia-questa-chiave-in-produzione
CORS_ORIGIN=*
# Dopo quanto tempo un profilo rifiutato torna fra i candidati dello swipe
# (qualsiasi intervallo Postgres: '30 minutes', '1 hour', '1 day')
SWIPE_GRAZIA_RIFIUTO=1 month

# --- accesso al pannello di controllo ---
# Nome utente dell'amministratore (non e' un'email: ha un form dedicato).
ADMIN_USERNAME=
# Hash bcrypt della password, fra apici singoli. Si genera con:
#   node -e "require('./src/config/hash').hashPassword('LA-TUA-PASSWORD').then(console.log)"
ADMIN_PASSWORD_HASH=''
# In alternativa (sconsigliato) la password in chiaro:
# ADMIN_PASSWORD=
