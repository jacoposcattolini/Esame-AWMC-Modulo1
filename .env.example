# ============================================================
# Copia questo file in ".env" e il progetto parte cosi' com'e':
#
#   cp .env.example .env
#   docker compose up --build
#
# I valori qui sotto sono pensati per l'uso LOCALE (sviluppo e prova).
# Mettendo il progetto online vanno sostituiti tutti: chiave di firma nuova,
# password del database nuova e password dell'amministratore nuova.
# Il file .env non va versionato (e' gia' escluso in .gitignore).
# ============================================================

# --- database ---
POSTGRES_USER=sporteasy
POSTGRES_PASSWORD=sporteasy
POSTGRES_DB=sporteasy

# --- firma dei token di accesso ---
# In produzione: una stringa lunga e casuale, generata con
#   openssl rand -base64 36
JWT_SECRET=chiave-di-sviluppo-locale-da-sostituire-in-produzione

# --- accesso al pannello di controllo ---
# Nome utente dell'amministratore (non e' un'email: ha un modulo di accesso
# dedicato, in alto a destra nella schermata "Accedi").
ADMIN_USERNAME=admin

# Hash bcrypt della password, FRA APICI SINGOLI: senza gli apici docker compose
# interpreta i "$" dell'hash come variabili e lo consegna troncato.
# L'hash qui sotto corrisponde alla password di sviluppo: adminsporteasy.2026
# Per generarne uno nuovo, con i container avviati:
#   docker compose exec backend node -e "require('./src/config/hash').hashPassword('LA-TUA-PASSWORD').then(console.log)"
ADMIN_PASSWORD_HASH='$2b$10$QuLtzEV4fII6s1cEJ1/oFOvgZZMrtJQ7kj6mvh6Rv6J1y4veTc5vK'

# In alternativa all'hash si puo' indicare la password in chiaro (sconsigliato):
# ADMIN_PASSWORD=
